# ─── Required ─────────────────────────────────────────
ENV=production
PORT=8080

# Database
POSTGRES_PASSWORD=<generate-strong-password>
DATABASE_URL=postgres://typecall:${POSTGRES_PASSWORD}@postgres:5432/typecall?sslmode=disable

# Redis
REDIS_PASSWORD=<generate-strong-password>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Auth (min 32 chars each)
JWT_SECRET=<openssl-rand-base64-48>
CSRF_SECRET=<openssl-rand-base64-32>

# Encryption (32 bytes hex for AES-256-GCM)
ENCRYPTION_KEY=<openssl-rand-hex-32>

# ─── Frontend ─────────────────────────────────────────
VITE_API_URL=https://api.typecall.io
CORS_ORIGINS=https://app.typecall.io,https://typecall.io

# ─── Optional ─────────────────────────────────────────
VERSION=latest
